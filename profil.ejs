<div class="max-w-3xl mx-auto space-y-6">
    <div class="bg-gradient-to-r from-emerald-800 via-emerald-900 to-slate-900 rounded-3xl p-6 text-white shadow-xl">
        <div class="flex flex-col sm:flex-row items-center sm:items-center gap-5">
            <div class="w-24 h-24 rounded-2xl bg-white/10 border-2 border-white/20 shadow-xl flex items-center justify-center flex-shrink-0">
                <i class="fas fa-user text-4xl text-emerald-200"></i>
            </div>
            <div class="text-center sm:text-left flex-1">
                <span class="bg-white/10 text-emerald-200 text-[11px] px-3 py-1 rounded-full font-medium inline-block mb-2">Profil Pengguna & Pegawai</span>
                <h2 class="text-2xl font-extrabold tracking-tight"><%- h(currentUser.name) %></h2>
                <p class="text-emerald-100 text-xs mt-0.5"><%- emp.position ? h(emp.position) : 'Jabatan belum diisi' %></p>
                <p class="text-emerald-300/80 text-[11px] mt-1"><i class="fas fa-building mr-1"></i><%- emp.department ? h(emp.department) : 'Unit kerja belum diisi' %></p>
                <span class="inline-block mt-2 bg-emerald-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow border border-white"><%- strtoupper(currentUser.role) %></span>
            </div>
        </div>
    </div>

    <div class="bg-white p-6 md:p-8 rounded-3xl border border-slate-200/80 shadow-sm">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-6">
            <div>
                <h3 class="font-bold text-slate-800 text-base">Edit Data Profil & Akun</h3>
                <p class="text-xs text-slate-500 mt-0.5">Perbarui informasi biodata dan kata sandi akun Anda.</p>
            </div>
            <span class="px-3 py-1 bg-slate-100 text-slate-700 text-xs font-bold rounded-xl uppercase"><%- currentUser.role %></span>
        </div>

        <form action="actions/user" method="POST" class="space-y-5">
            <input type="hidden" name="action" value="update_profile">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Nama Lengkap</label>
                    <input type="text" name="name" value="<%- h(emp.name) %>" placeholder="Isi nama lengkap" class="w-full p-3 text-xs rounded-xl border border-slate-200">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">NIP / NIK</label>
                    <input type="text" name="nip" value="<%- h(emp.nip) %>" placeholder="Isi NIP / NIK" class="w-full p-3 text-xs rounded-xl border border-slate-200">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Email Instansi (Login)</label>
                    <input type="email" name="email" value="<%- h(currentUser.email) %>" required class="w-full p-3 text-xs rounded-xl border border-slate-200">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Nomor Telepon / WhatsApp</label>
                    <input type="text" name="phone" value="<%- h(emp.phone) %>" placeholder="Contoh: 0812xxxxxxxx" class="w-full p-3 text-xs rounded-xl border border-slate-200">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Jabatan</label>
                    <input type="text" name="position" value="<%- h(emp.position) %>" placeholder="Isi jabatan" class="w-full p-3 text-xs rounded-xl border border-slate-200">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Unit Kerja / Bagian</label>
                    <input type="text" name="department" value="<%- h(emp.department) %>" placeholder="Isi unit kerja / bagian" class="w-full p-3 text-xs rounded-xl border border-slate-200">
                </div>
            </div>

            <div class="pt-4 border-t border-slate-100">
                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Password Baru <span class="text-slate-400 font-normal">(Opsional)</span></label>
                <input type="password" name="password" placeholder="••••••••" class="w-full p-3 text-xs rounded-xl border border-slate-200">
            </div>

            <div class="pt-2 flex justify-end gap-3">
                <button type="submit" class="w-full sm:w-auto bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-6 py-3 rounded-xl text-xs transition shadow-lg shadow-emerald-700/30 flex items-center justify-center gap-2">
                    <i class="fas fa-save"></i> Simpan Perubahan Profil
                </button>
            </div>
        </form>
    </div>
</div>