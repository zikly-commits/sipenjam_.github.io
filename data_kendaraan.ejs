<div class="space-y-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
        <div>
            <h2 class="text-xl font-bold text-slate-800">Data Kendaraan Dinas</h2>
            <p class="text-xs text-slate-500 mt-0.5">Kelola armada mobil dan sepeda motor operasional dinas.</p>
        </div>
        <button onclick="openVehicleModal()" class="bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-2">
            <i class="fas fa-plus"></i> Tambah Kendaraan Baru
        </button>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-500 uppercase font-semibold border-b border-slate-100">
                    <tr>
                        <th class="p-4">Foto</th>
                        <th class="p-4">ID & Jenis</th>
                        <th class="p-4">Merk / Model</th>
                        <th class="p-4">Nomor Polisi</th>
                        <th class="p-4">Tahun</th>
                        <th class="p-4">Kondisi</th>
                        <th class="p-4">Status</th>
                        <th class="p-4 text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% (vehicles).forEach(function(v) {  %>
                        <tr class="hover:bg-slate-50 transition">
                            <td class="p-4">
                                <img src="<%- vehicle_photo_url(v) %>" alt="Foto <%- h(v.brand + ' ' + v.model) %>" loading="lazy" class="w-20 h-14 rounded-lg object-cover border border-slate-200 bg-slate-100">
                            </td>
                            <td class="p-4 font-bold text-slate-800">
                                <div class="flex items-center gap-2">
                                    <i class="fas <%- v.vehicle_type === 'Mobil' ? 'fa-car text-blue-600' : 'fa-motorcycle text-amber-600' %> text-base"></i>
                                    <div>
                                        <p><%- v.vehicle_type %></p>
                                        <p class="text-[10px] text-slate-400"><%- v.id %></p>
                                    </div>
                                </div>
                            </td>
                            <td class="p-4 font-bold text-slate-800"><%- h(v.brand + ' ' + v.model) %></td>
                            <td class="p-4"><span class="px-2 py-1 bg-slate-100 text-slate-800 font-mono font-bold rounded"><%- h(v.license_plate) %></span></td>
                            <td class="p-4 text-slate-600"><%- v.year %></td>
                            <td class="p-4 text-slate-600"><%- h(v.condition) %></td>
                            <td class="p-4">
                                <% var bk = vehicleBookings[v.id] ?? []; var effStatus = auto_item_status(bk, v.status, 'vehicle'); %>
                                <span class="px-2 py-1 rounded-full text-[10px] font-bold <%- effStatus === 'Tersedia' ? 'bg-emerald-100 text-emerald-800' : (effStatus === 'Dipinjam' ? 'bg-blue-100 text-blue-800' : 'bg-amber-100 text-amber-800') %>">
                                    <%- effStatus %>
                                </span>
                                <div class="-mx-3 -mb-3"><%- render_booking_schedule(bk, 2, v.status, 'Tersedia') %></div>
                            </td>
                            <td class="p-4 text-center space-x-1">
                                <button onclick='openVehicleModal(<%- json_encode(Object.assign({}, v, {photo_url: vehicle_photo_url(v)})) %>)' class="p-2 text-slate-600 hover:text-emerald-700 hover:bg-slate-100 rounded-lg"><i class="fas fa-pen"></i></button>
                                <a href="actions/vehicle?action=delete&id=<%- v.id %>" onclick="return confirm('Hapus kendaraan ini?')" class="p-2 text-slate-600 hover:text-rose-600 hover:bg-rose-50 rounded-lg"><i class="fas fa-trash"></i></a>
                            </td>
                        </tr>
                    <% });  %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="assets/js/views/data_kendaraan.js"></script>
