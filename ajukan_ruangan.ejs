<div class="max-w-3xl mx-auto space-y-6">
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
        <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 bg-emerald-100 text-emerald-700 rounded-xl flex items-center justify-center font-bold">
                <i class="fas fa-door-open text-lg"></i>
            </div>
            <div>
                <h2 class="text-lg font-bold text-slate-800">Form Pengajuan Peminjaman Ruangan</h2>
                <p class="text-xs text-slate-500">Lengkapi detail peminjaman untuk verifikasi persetujuan admin.</p>
            </div>
        </div>

        <form action="actions/booking" method="POST" class="space-y-4 mt-6">
            <input type="hidden" name="action" value="submit_room">
            <% if (isset(query.error) && query.error === 'conflict') {  %>
                <div class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 text-xs font-semibold flex items-center gap-2">
                    <i class="fas fa-triangle-exclamation text-base"></i>
                    <span>Ruangan tidak tersedia pada waktu tersebut. Silakan pilih ruangan lain atau ubah jam.</span>
                </div>
            <% }  %>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Pemohon</label>
                    <input type="text" name="applicant_name" required placeholder="Nama lengkap pemohon" class="w-full p-2.5 text-xs rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-600">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">NIP / NIK</label>
                    <input type="text" name="nip" required placeholder="NIP / NIK" class="w-full p-2.5 text-xs rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-600">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Bagian / Unit Kerja</label>
                    <input type="text" name="department" required placeholder="Contoh: Sub Bagian TU" class="w-full p-2.5 text-xs rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-600">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Kegiatan / Agenda Rapat</label>
                <input type="text" name="activity_name" required placeholder="Contoh: Rapat Koordinasi Evaluasi Anggaran Kanwil" class="w-full p-2.5 text-xs rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-600">
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-2">Pilih Ruangan Rapat</label>
                <% if (empty(rooms)) {  %>
                    <p class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-500">Belum ada ruangan yang tersedia.</p>
                <% } else {  %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <% (rooms).forEach(function(r) {  %>
                            <% var bk = roomBookings[r.id] ?? [];
                                var badge = booking_badge(bk, r.status, 'Tersedia');
                                var blocked = r.status !== 'Tersedia'; %>
                            <label class="booking-card relative block <%- blocked ? 'cursor-not-allowed' : 'cursor-pointer' %> group" data-bookings="<%- h(json_encode(bk), ENT_QUOTES) %>" data-blocked="<%- blocked ? '1' : '0' %>">
                                <input type="radio" name="room_id" value="<%- h(r.id) %>" required <%- blocked ? 'disabled' : '' %> class="peer sr-only">
                                <div class="card-body h-full rounded-2xl border-2 border-slate-200 bg-white overflow-hidden transition group-hover:border-emerald-300 peer-checked:border-emerald-600 peer-checked:ring-4 peer-checked:ring-emerald-600/15 peer-focus-visible:ring-4 peer-focus-visible:ring-emerald-600/30">
                                    <div class="relative">
                                        <img src="<%- room_photo_url(r) %>" alt="Foto <%- h(r.room_name) %>" loading="lazy" class="card-photo w-full h-32 object-cover bg-slate-100 <%- blocked ? 'grayscale opacity-70' : '' %>">
                                        <% if (badge) {  %>
                                            <span class="absolute top-2 left-2 px-2 py-1 rounded-full text-[10px] font-bold shadow <%- badge[1] %>"><%- h(badge[0]) %></span>
                                        <% }  %>
                                        <span class="conflict-badge hidden absolute bottom-2 left-2 px-2 py-1 rounded-full text-[10px] font-bold shadow bg-rose-600 text-white"><i class="fas fa-ban mr-1"></i>Bentrok dengan jadwal pilihan Anda</span>
                                    </div>
                                    <%- render_booking_schedule(bk, 3, r.status, 'Tersedia') %>
                                    <div class="p-3 space-y-1">
                                        <p class="text-xs font-bold text-slate-800 leading-snug"><%- h(r.room_name) %></p>
                                        <p class="text-[11px] text-slate-500 flex items-center gap-1.5"><i class="fas fa-users w-3.5 text-emerald-600"></i> Kapasitas <%- intval(r.capacity) %> orang</p>
                                        <p class="text-[11px] text-slate-500 flex items-center gap-1.5"><i class="fas fa-location-dot w-3.5 text-emerald-600"></i> <%- h(r.location) %></p>
                                        <p class="text-[10px] text-slate-400 line-clamp-2"><%- h(r.facilities) %></p>
                                    </div>
                                </div>
                                <span class="absolute top-2 right-2 hidden peer-checked:flex w-6 h-6 items-center justify-center rounded-full bg-emerald-600 text-white text-[10px] shadow"><i class="fas fa-check"></i></span>
                            </label>
                        <% });  %>
                    </div>
                <% }  %>
            </div>

            <div class="md:w-1/2">
                <label class="block text-xs font-semibold text-slate-700 mb-1">Jumlah Peserta (Orang)</label>
                <input type="number" name="participants" required min="1" placeholder="15" class="w-full p-2.5 text-xs rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-600">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Peminjaman</label>
                    <input type="date" name="date" value="<%- todayStr %>" min="<%- todayStr %>" required class="w-full p-2.5 text-xs rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-600">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Waktu Mulai</label>
                    <input type="time" name="start_time" value="09:00" required class="w-full p-2.5 text-xs rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-600">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Waktu Selesai</label>
                    <input type="time" name="end_time" value="11:30" required class="w-full p-2.5 text-xs rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-600">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Keperluan / Tujuan</label>
                <textarea name="purpose" required rows="2" placeholder="Jelaskan secara singkat urusan dinas..." class="w-full p-2.5 text-xs rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-600"></textarea>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Catatan Perlengkapan Tambahan</label>
                <input type="text" name="notes" placeholder="Contoh: Butuh 2 Wireless Mic dan Zoom Room" class="w-full p-2.5 text-xs rounded-xl border border-slate-200 focus:ring-2 focus:ring-emerald-600">
            </div>

            <div class="pt-4 border-t border-slate-100 flex justify-end gap-3">
                <a href="?page=dashboard" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl">Batal</a>
                <button type="submit" class="px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold rounded-xl shadow-lg shadow-emerald-700/30">Kirim Pengajuan</button>
            </div>
        </form>
    </div>
</div>

<script src="assets/js/views/booking_availability.js"></script>
