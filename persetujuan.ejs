<div class="space-y-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
        <div>
            <h2 class="text-xl font-bold text-slate-800">Persetujuan Peminjaman</h2>
            <p class="text-xs text-slate-500 mt-0.5">Proses persetujuan atau penolakan pengajuan fasilitas dari pegawai.</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-500 uppercase font-semibold border-b border-slate-100">
                    <tr>
                        <th class="p-4">Pemohon</th>
                        <th class="p-4">Jenis & Fasilitas</th>
                        <th class="p-4">Tanggal & Jam</th>
                        <th class="p-4">Keperluan</th>
                        <th class="p-4">Status</th>
                        <th class="p-4 text-center">Aksi Persetujuan</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% if (empty(allRequests)) {  %>
                        <tr><td colspan="6" class="p-6 text-center text-slate-400">Tidak ada data pengajuan.</td></tr>
                    <% } else {  %>
                        <% (allRequests).forEach(function(req) {  %>
                            <tr class="hover:bg-slate-50 transition">
                                <td class="p-4">
                                    <p class="font-bold text-slate-800"><%- h(req.applicant_name) %></p>
                                    <p class="text-[10px] text-slate-400"><%- h(req.department) %></p>
                                </td>
                                <td class="p-4">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold <%- req.category === 'Ruangan' ? 'bg-blue-100 text-blue-800' : 'bg-emerald-100 text-emerald-800' %> mb-1 inline-block"><%- req.category %></span>
                                    <p class="font-semibold text-slate-700"><%- h(req.title) %></p>
                                </td>
                                <td class="p-4 text-slate-600">
                                    <div><%- req.booking_date %></div>
                                    <div class="text-[10px] text-slate-400"><%- req.start_time %> - <%- req.end_time %></div>
                                </td>
                                <td class="p-4 text-slate-600 max-w-xs truncate"><%- h(req.purpose) %></td>
                                <td class="p-4">
                                    <% var s = req.status;var cls = "bg-slate-100 text-slate-700";
                                        if (s === 'Menunggu')var cls = "bg-amber-100 text-amber-800 border border-amber-200";
                                        if (s === 'Disetujui')var cls = "bg-emerald-100 text-emerald-800 border border-emerald-200";
                                        if (s === 'Ditolak')var cls = "bg-rose-100 text-rose-800 border border-rose-200"; %>
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold <%- cls %>"><%- s %></span>
                                </td>
                                <td class="p-4 text-center">
                                    <% if (req.status === 'Menunggu') {  %>
                                        <div class="flex items-center justify-center gap-2">
                                            <a href="actions/booking?action=approve&id=<%- req.id %>&type=<%- req.category === 'Ruangan' ? 'room' : 'vehicle' %>" class="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg font-bold text-xs shadow-sm">
                                                <i class="fas fa-check"></i> Setujui
                                            </a>
                                            <button onclick="openRejectModal('<%- req.id %>', '<%- req.category === 'Ruangan' ? 'room' : 'vehicle' %>')" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white rounded-lg font-bold text-xs shadow-sm">
                                                <i class="fas fa-xmark"></i> Tolak
                                            </button>
                                        </div>
                                    <% } else {  %>
                                        <span class="text-slate-400 text-xs">-</span>
                                    <% }  %>
                                </td>
                            </tr>
                        <% });  %>
                    <% }  %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="assets/js/views/persetujuan.js"></script>
