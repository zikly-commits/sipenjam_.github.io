<div class="space-y-6">
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
            <h2 class="text-xl font-bold text-slate-800">Riwayat Peminjaman</h2>
            <p class="text-xs text-slate-500 mt-0.5">Arsip seluruh histori permohonan peminjaman fasilitas instansi.</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-500 uppercase font-semibold border-b border-slate-100">
                    <tr>
                        <th class="p-4">No</th>
                        <th class="p-4">Pemohon</th>
                        <th class="p-4">Jenis</th>
                        <th class="p-4">Fasilitas</th>
                        <th class="p-4">Tanggal & Jam</th>
                        <th class="p-4">Status</th>
                        <th class="p-4 text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% if (empty(allHistory)) {  %>
                        <tr><td colspan="7" class="p-6 text-center text-slate-400">Belum ada riwayat peminjaman.</td></tr>
                    <% } else {  %>
                        <% (allHistory).forEach(function(item, idx) {  %>
                            <tr class="hover:bg-slate-50 transition">
                                <td class="p-4 text-slate-400"><%- idx + 1 %></td>
                                <td class="p-4 font-bold text-slate-800"><%- h(item.applicant_name) %></td>
                                <td class="p-4"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700"><%- item.category %></span></td>
                                <td class="p-4 font-semibold text-slate-700"><%- h(item.title) %></td>
                                <td class="p-4 text-slate-600"><%- item.booking_date %> (<%- item.start_time %> - <%- item.end_time %>)</td>
                                <td class="p-4">
                                    <% var s = item.status;
                                        var cls = "bg-slate-100 text-slate-700";
                                        if (s === 'Menunggu') var cls = "bg-amber-100 text-amber-800 border border-amber-200";
                                        if (s === 'Disetujui') var cls = "bg-emerald-100 text-emerald-800 border border-emerald-200";
                                        if (s === 'Ditolak') var cls = "bg-rose-100 text-rose-800 border border-rose-200"; %>
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold <%- cls %>"><%- s %></span>
                                </td>
                                <td class="p-4 text-center">
                                    <% if (item.status !== 'Menunggu') {  %>
                                        <a href="actions/booking?action=delete&id=<%- item.id %>&type=<%- item.category === 'Ruangan' ? 'room' : 'vehicle' %>" onclick="return confirm('Hapus riwayat ini?')" class="text-rose-600 hover:bg-rose-50 p-2 rounded-lg font-bold" title="Hapus Riwayat">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    <% }  %>
                                </td>
                            </tr>
                        <% });  %>
                    <% }  %>
                </tbody>
            </table>
        </div>
    </div>
</div>