<!doctype html>
<html lang="id" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>SIPENJAM - Tolak Peminjaman</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/assets/css/base.css" />
</head>
<body class="h-full text-slate-800 antialiased bg-slate-50">
    <div class="min-h-screen flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl shadow-xl max-w-sm w-full overflow-hidden border border-slate-200/80">
            <div class="bg-rose-600 p-6 text-center text-white">
                <i class="fas fa-circle-xmark text-3xl mb-2"></i>
                <h1 class="text-base font-bold">Tolak Peminjaman?</h1>
                <p class="text-[11px] text-rose-100 mt-1">Pilih alasan penolakan untuk disampaikan ke pemohon.</p>
            </div>
            <div class="p-6">
                <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold mb-2 <%- pengajuan.category === 'Ruangan' ? 'bg-blue-100 text-blue-800' : 'bg-emerald-100 text-emerald-800' %>"><%- pengajuan.category %></span>
                <p class="font-bold text-slate-800 text-sm mb-3"><%- h(pengajuan.title) %></p>

                <dl class="space-y-2 text-xs text-slate-600 bg-slate-50 rounded-xl p-4 border border-slate-100">
                    <div class="flex gap-2"><dt class="w-20 shrink-0 font-semibold text-slate-500">Pemohon</dt><dd><%- h(pengajuan.applicant_name) %> &middot; <%- h(pengajuan.department) %></dd></div>
                    <div class="flex gap-2"><dt class="w-20 shrink-0 font-semibold text-slate-500">Tanggal</dt><dd><%- pengajuan.booking_date %>, <%- String(pengajuan.start_time).slice(0,5) %> - <%- String(pengajuan.end_time).slice(0,5) %> WIB</dd></div>
                    <div class="flex gap-2"><dt class="w-20 shrink-0 font-semibold text-slate-500">Keperluan</dt><dd><%- h(pengajuan.purpose) %></dd></div>
                </dl>

                <% if (errorReason) { %>
                    <p class="text-[11px] text-rose-600 font-semibold mt-3"><i class="fas fa-triangle-exclamation mr-1"></i><%- h(errorReason) %></p>
                <% } %>

                <form action="/konfirmasi/tolak/<%- token %>" method="POST" class="pt-4 space-y-3">
                    <select name="reason" required class="w-full p-3 text-xs rounded-xl border border-slate-200 bg-white text-slate-700 focus:outline-none focus:ring-2 focus:ring-rose-500">
                        <option value="">-- Pilih Alasan Penolakan --</option>
                        <option value="Jadwal bentrok dengan agenda prioritas pimpinan">Jadwal bentrok dengan agenda prioritas pimpinan</option>
                        <option value="Ruangan sedang digunakan untuk kegiatan lain">Ruangan sedang digunakan untuk kegiatan lain</option>
                        <option value="Kendaraan sedang digunakan untuk keperluan dinas lain">Kendaraan sedang digunakan untuk keperluan dinas lain</option>
                        <option value="Fasilitas yang diminta tidak tersedia">Fasilitas yang diminta tidak tersedia</option>
                    </select>
                    <button type="submit" class="w-full bg-rose-600 hover:bg-rose-700 text-white font-bold py-3.5 rounded-xl text-xs shadow-sm transition">
                        <i class="fas fa-xmark mr-1.5"></i> Tolak Peminjaman
                    </button>
                </form>
                <p class="text-[10px] text-slate-400 text-center mt-3">Ingin menyetujui? Gunakan tautan "Setujui" pada pesan WhatsApp.</p>
            </div>
        </div>
    </div>
</body>
</html>
