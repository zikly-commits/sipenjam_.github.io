<div class="space-y-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
        <div>
            <h2 class="text-xl font-bold text-slate-800">Data Pegawai Instansi</h2>
            <p class="text-xs text-slate-500 mt-0.5">Daftar aparatur / pegawai terdaftar dalam sistem peminjaman.</p>
        </div>
        <button onclick="openEmployeeModal()" class="bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-2">
            <i class="fas fa-user-plus"></i> Tambah Pegawai Baru
        </button>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 text-slate-500 uppercase font-semibold border-b border-slate-100">
                    <tr>
                        <th class="p-4">Pegawai</th>
                        <th class="p-4">NIP</th>
                        <th class="p-4">Jabatan</th>
                        <th class="p-4">Unit Kerja</th>
                        <th class="p-4">Kontak</th>
                        <th class="p-4 text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <% (employees).forEach(function(emp) {  %>
                        <tr class="hover:bg-slate-50 transition">
                            <td class="p-4 font-bold text-slate-800">
                                <div>
                                    <p><%- h(emp.name) %></p>
                                    <p class="text-[10px] text-slate-400"><%- h(emp.email) %></p>
                                </div>
                            </td>
                            <td class="p-4 text-slate-600 font-mono"><%- h(emp.nip) %></td>
                            <td class="p-4 text-slate-700 font-medium"><%- h(emp.position) %></td>
                            <td class="p-4 text-slate-600"><%- h(emp.department) %></td>
                            <td class="p-4 text-slate-600"><%- h(emp.phone) %></td>
                            <td class="p-4 text-center space-x-1">
                                <button onclick='openEmployeeModal(<%- json_encode(emp) %>)' class="p-2 text-slate-600 hover:text-emerald-700 hover:bg-slate-100 rounded-lg"><i class="fas fa-pen"></i></button>
                                <a href="actions/employee?action=delete&id=<%- emp.id %>" onclick="return confirm('Hapus pegawai ini?')" class="p-2 text-slate-600 hover:text-rose-600 hover:bg-rose-50 rounded-lg"><i class="fas fa-trash"></i></a>
                            </td>
                        </tr>
                    <% });  %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="assets/js/views/data_pegawai.js"></script>
