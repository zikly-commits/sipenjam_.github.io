<div class="space-y-6">
    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 no-print">
        <div>
            <h2 class="text-xl font-bold text-slate-800">Laporan Rekapitulasi Peminjaman</h2>
            <p class="text-xs text-slate-500 mt-0.5">Cetak & ekspor rekap data penggunaan aset ruangan dan kendaraan dinas Kanwil Kemenag Babel.</p>
        </div>
        <div class="flex items-center gap-2">
            <button onclick="window.print()" class="bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow transition flex items-center gap-2">
                <i class="fas fa-print"></i> Cetak Laporan
            </button>
        </div>
    </div>

    <div class="bg-white p-8 rounded-2xl border border-slate-200/80 shadow-sm">
        <div class="pb-5 border-b-2 border-slate-800 mb-6">
            <div class="flex items-center justify-center gap-5">
                <div class="flex-shrink-0">
                    <img src="./assets/images/logo-kemenag.png" alt="Logo Kementerian Agama" class="w-20 h-20 object-contain">
                </div>
                <div class="text-center flex-1">
                    <h1 class="text-lg sm:text-xl font-bold uppercase tracking-wide text-slate-900">KEMENTERIAN AGAMA REPUBLIK INDONESIA</h1>
                    <h2 class="text-base sm:text-lg font-bold uppercase text-emerald-800 mt-1">KANTOR WILAYAH KEMENTERIAN AGAMA PROVINSI BANGKA BELITUNG</h2>
                    <p class="text-sm text-slate-700 font-semibold mt-1">SIPENJAM - Sistem Informasi Peminjaman Ruangan & Kendaraan Dinas</p>
                    <p class="text-xs text-slate-500 mt-1">Jl. Kompleks Perkantoran Terpadu Pemprov Bangka Belitung, Air Itam, Pangkalpinang</p>
                </div>
            </div>
        </div>

        <h3 class="text-xs sm:text-sm font-bold text-slate-800 mb-4 uppercase text-center">REKAPITULASI DATA PEMINJAMAN FASILITAS DINAS</h3>

        <table class="w-full text-left text-xs border-collapse">
            <thead>
                <tr class="bg-slate-100 text-slate-800 font-bold border-y border-slate-300">
                    <th class="p-3">No</th>
                    <th class="p-3">Pemohon</th>
                    <th class="p-3">NIP</th>
                    <th class="p-3">Jenis Peminjaman</th>
                    <th class="p-3">Fasilitas</th>
                    <th class="p-3">Tanggal</th>
                    <th class="p-3">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                <% (allReports).forEach(function(item, idx) {  %>
                    <tr>
                        <td class="p-3"><%- idx + 1 %></td>
                        <td class="p-3 font-semibold"><%- h(item.applicant_name) %></td>
                        <td class="p-3 font-mono"><%- h(item.nip) %></td>
                        <td class="p-3"><%- isset(item.room_id) ? "Ruangan Rapat" : "Kendaraan Dinas" %></td>
                        <td class="p-3 font-semibold"><%- h(isset(item.room_id) ? item.room_name : item.brand) %></td>
                        <td class="p-3"><%- item.booking_date ?? item.departure_date %></td>
                        <td class="p-3"><%- item.status %></td>
                    </tr>
                <% });  %>
            </tbody>
        </table>

        <div class="mt-12 flex justify-between text-xs text-slate-700">
            <div></div>
            <div class="text-center">
                <p>Pangkalpinang, <%- date('d F Y') %></p>
                <p class="font-bold mt-1 mb-16">Mengetahui,<br>Kepala Subbagian Umum & Humas</p>
                <p class="font-bold underline">( .................................................... )</p>
                <p class="text-[10px] text-slate-500">NIP. ....................................................</p>
            </div>
        </div>
    </div>
</div>