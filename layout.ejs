<!doctype html>
<html lang="id" class="h-full bg-slate-50">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIPENJAM - Kanwil Kemenag Prov. Bangka Belitung</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="assets/js/tailwind-config.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="assets/css/base.css" />
    <link rel="stylesheet" href="assets/css/app.css" />
</head>

<body class="h-full text-slate-800 antialiased bg-slate-50">
    <script src="assets/js/app.js"></script>

    <div id="app" class="min-h-screen flex flex-col">
        <div class="flex h-screen overflow-hidden bg-slate-100">
            <div class="hidden lg:block">
                <%- include('partials/sidebar') %>
            </div>

            <div id="mobile-sidebar" class="hidden fixed inset-0 z-40 bg-slate-900/60 backdrop-blur-sm lg:hidden" onclick="toggleMobileSidebar()"></div>
            <div id="mobile-sidebar-panel" class="hidden fixed inset-y-0 left-0 z-50 w-64 bg-slate-900 lg:hidden shadow-2xl flex-col">
                <%- include('partials/sidebar') %>
            </div>

            <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
                <%- include('partials/navbar') %>

                    <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8">
                        <div class="max-w-7xl mx-auto">
                            <% if (accessError) { %>
                                <div class="mb-6 p-4 bg-rose-100 border border-rose-200 rounded-2xl text-rose-700 text-xs flex items-center justify-between">
                                    <span><i class="fas fa-shield-cat mr-2 text-base"></i> <%- accessErrorMsg || 'Akses Ditolak. Halaman khusus untuk Administrator Instansi.' %></span>
                                    <button onclick="this.parentElement.remove()" class="font-bold">&times;</button>
                                </div>
                                <% } %>

                                    <%- include('pages/' + viewFile) %>
                        </div>
                    </main>
            </div>
        </div>
    </div>

    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>
    <div id="modal-container" class="relative z-40 hidden"></div>

    <script>
        <% if (query.msg === 'success') { %>
        showToast('Operasi berhasil disimpan.');
        <% } %>
        <% if (query.msg === 'deleted') { %>
        showToast('Data berhasil dihapus.');
        <% } %>
        <% if (isset(query.photo_error)) {%>
        showToast('Data tersimpan, tetapi foto gagal diunggah. Gunakan JPG/PNG/WebP maksimal 5 MB.', 'error');
        <% } %>
    </script>
</body>

</html>