<!doctype html>
<html lang="id" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>SIPENJAM - Konfirmasi Peminjaman</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/assets/css/base.css" />
</head>
<body class="h-full text-slate-800 antialiased bg-slate-50">
    <div class="min-h-screen flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl shadow-xl max-w-sm w-full overflow-hidden border border-slate-200/80 text-center">
            <div class="p-8">
                <% var icon = type === 'success' ? 'fa-circle-check' : type === 'error' ? 'fa-circle-xmark' : 'fa-circle-info';
                   var color = type === 'success' ? 'text-emerald-600 bg-emerald-50' : type === 'error' ? 'text-rose-600 bg-rose-50' : 'text-amber-600 bg-amber-50'; %>
                <div class="w-16 h-16 rounded-full <%- color %> flex items-center justify-center mx-auto mb-5">
                    <i class="fas <%- icon %> text-3xl"></i>
                </div>
                <h1 class="text-lg font-bold text-slate-800 mb-2"><%- h(title) %></h1>
                <p class="text-xs text-slate-500 leading-relaxed"><%- h(message) %></p>
            </div>
            <div class="px-8 pb-6 pt-2 border-t border-slate-100">
                <p class="text-[10px] text-slate-400 mt-4">SIPENJAM &middot; Kanwil Kemenag Prov. Bangka Belitung</p>
            </div>
        </div>
    </div>
</body>
</html>
